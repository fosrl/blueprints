BLUEPRINT_NAME=vaultwarden
RESOURCE_NAME=Vaultwarden
SERVICE_SUBDOMAIN=vault
SERVICE_CONTAINER_NAME=vaultwarden
SERVICE_PORT=80

VAULTWARDEN_IMAGE=vaultwarden/server
VAULTWARDEN_TAG=latest

# Set to false after you have created your account.
SIGNUPS_ALLOWED=true

# Optional: enable the /admin page by setting a token. Use an argon2 PHC string
# (generate with `docker run --rm -it vaultwarden/server /vaultwarden hash`)
# and wrap it in single quotes so Compose does not expand the `$` characters.
# ADMIN_TOKEN='$argon2id$...'

# Optional resource-specific auth overrides and additions.
# Bitwarden clients cannot complete Pangolin SSO; set this to false if apps fail to log in.
# RESOURCE_AUTH_SSO_ENABLED=false
# RESOURCE_AUTH_SSO_ROLE_0=Admin
# RESOURCE_AUTH_WHITELIST_USER_0=admin@example.com
